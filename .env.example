# Copy this file to `.env` and fill in real values.
# Get an OpenRouter key at https://openrouter.ai/keys
# Free models work with a $0 balance; paid models need credits.
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
# Vision-capable model used for photo-proof verification.
OPENROUTER_VISION_MODEL=google/gemma-4-26b-a4b-it:free

# Supabase project credentials (optional — leave empty for demo mode).
# https://supabase.com/dashboard
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
